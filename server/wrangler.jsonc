{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teamleader-chatgpt",
  "main": "src/index.ts",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "migrations": [{ "new_sqlite_classes": ["TeamleaderMCP"], "tag": "v1" }],
  "durable_objects": {
    "bindings": [{ "class_name": "TeamleaderMCP", "name": "MCP_OBJECT" }]
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "cf0a54d6afc0466989e227a8ab0ce5c4" }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "dev": { "port": 8788 }
}
